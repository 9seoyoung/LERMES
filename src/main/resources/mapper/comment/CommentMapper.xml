    <select id="findCommentsByPost" resultType="com.kdt.KDT_PJT.comment.dto.CommentDto">
        SELECT
            CMNT_SN,
            POST_SN,
            CMNT_CN,
            CMNT_WRTR_SN,
            CMNT_FRST_WRT_DT,
            CMNT_LAST_MDFCN_DT,
            DEL_YN,
            PARENT_CMNT_SN
        FROM TB_COMMENT
        WHERE POST_SN = #{postSn}
          AND DEL_YN = FALSE
        ORDER BY
            CASE WHEN PARENT_CMNT_SN IS NULL THEN CMNT_SN ELSE PARENT_CMNT_SN END,
            CMNT_SN
    </select>

    <!-- 댓글 단건 조회 -->
    <select id="findCommentById" resultType="com.kdt.KDT_PJT.comment.dto.CommentDto">
        SELECT
            CMNT_SN,
            POST_SN,
            CMNT_CN,
            CMNT_WRTR_SN,
            CMNT_FRST_WRT_DT,
            CMNT_LAST_MDFCN_DT,
            DEL_YN,
            PARENT_CMNT_SN
        FROM TB_COMMENT
        WHERE CMNT_SN = #{cmntSn}
    </select>

    <!-- 댓글 수정 -->
    <update id="updateComment" parameterType="com.kdt.KDT_PJT.comment.dto.CommentDto">
        UPDATE TB_COMMENT
        SET
            CMNT_CN = #{cmntCn},
            CMNT_LAST_MDFCN_DT = #{dto.cmntLastMdfcnDt}
        WHERE CMNT_SN = #{cmntSn}
          AND DEL_YN = FALSE
    </update>


    <!-- 댓글 삭제 (Soft Delete) -->
    <update id="softDeleteComment">
        UPDATE TB_COMMENT
        SET
            DEL_YN = TRUE,
            CMNT_LAST_MDFCN_DT = NOW(),
            LAST_MDFCN_USER_SN = #{userSn}
        WHERE CMNT_SN = #{cmntSn}
    </update>

    <!-- ✅ 특정 댓글의 자식(대댓글) 목록 조회 -->
    <select id="findRepliesByParent" parameterType="long" resultType="com.kdt.KDT_PJT.comment.dto.CommentDto">
        SELECT
            CMNT_SN,
            POST_SN,
            CMNT_CN,
            CMNT_WRTR_SN,
            CMNT_FRST_WRT_DT,
            CMNT_LAST_MDFCN_DT,
            DEL_YN,
            PARENT_CMNT_SN
        FROM TB_COMMENT
        WHERE PARENT_CMNT_SN = #{parentCmntSn}
          AND DEL_YN = FALSE
        ORDER BY CMNT_SN ASC
    </select>


</mapper>