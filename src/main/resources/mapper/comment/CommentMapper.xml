<mapper namespace="com.kdt.KDT_PJT.comment.mapper.CommentMapper">
    <insert id="insertComment" parameterType="com.kdt.KDT_PJT.comment.dto.CommentDto" useGeneratedKeys="true" keyProperty="cmntSn">
        INSERT INTO TB_COMMENT (
            POST_SN,
            CMNT_CN,
            CMNT_WRTR_SN,
            CMNT_FRST_WRT_DT,
            DEL_YN,
            PARENT_CMNT_SN
        )
        VALUES (
                   #{postSn},
                   #{cmntCn},
                   #{cmntWrtrSn},
                   #{cmntFrstWrtDt},
                   #{delYn},
                   #{parentCmntSn}
               )
    </insert>

