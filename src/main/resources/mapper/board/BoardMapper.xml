<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kdt.KDT_PJT.board.mapper.BoardMapper">

    <insert id="insertPost" parameterType="com.kdt.KDT_PJT.board.dto.PostRequestDto">
        INSERT INTO TB_POST (
        BBS_NM,
        POST_TTL,
        POST_CN,
        POST_WRTR_SN,
        POST_FRST_WRT_DT,
        CO_SN,
        COHORT_SN
        )
        VALUES (
        #{bbsNm},
        #{bbsTtl},
        #{bbsCn},
        #{postWrtrSn},
        NOW(),
        #{coSn},
        #{cohortSn}
        )
    </insert>

</mapper>